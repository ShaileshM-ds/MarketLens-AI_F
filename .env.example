# Copy to .env and adjust. Docker Compose reads .env automatically.
# Never commit .env. No real credentials belong in this file.

# Host ports (bound to 127.0.0.1 only)
WEB_PORT=8080
API_PORT=8000
MONGO_PORT=27018

# Demo, Imported and Live use SEPARATE databases. All four names must differ;
# the API and worker refuse to start if two are the same.
MONGO_DB_DEMO=marketlens_demo
MONGO_DB_IMPORTED=marketlens_imported
MONGO_DB_LIVE=marketlens_live
# Accounts and sessions (not data; never reset with Demo data).
MONGO_DB_ACCOUNTS=marketlens_accounts

# Live mode stays off until a provider, credentials and limits are configured.
LIVE_PROVIDER_ENABLED=false
# Imported product images: * = any https host; a comma list (e.g. images.example.com,cdn.example.org) = only
# those hosts and their subdomains; empty = no external images (the local generic image is shown).
IMAGE_HOSTS=*

# Origins allowed to call the API directly (the web app on :8080 uses a same-origin proxy).
CORS_ORIGINS=http://localhost:5173,http://localhost:8080

# Set true whenever the app is served over HTTPS (session cookie gets the Secure flag).
COOKIE_SECURE=false

WORKER_POLL_SECONDS=3
LOG_LEVEL=INFO
